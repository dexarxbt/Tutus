<%- include('partials/header') %>
<h1>Settings</h1>
<p class="page-subtitle">Organization configuration and preferences</p>

<div class="card">
  <div class="card-header">
    <h2>Organization</h2>
  </div>
  <% if (user.userRole === 'admin') { %>
  <form method="POST" action="/settings">
    <div class="form-group">
      <label for="org-name">Organization Name</label>
      <input type="text" id="org-name" name="name" class="form-input" value="<%= org.name %>" required>
    </div>
    <div class="form-group">
      <label>Plan</label>
      <input type="text" class="form-input" value="<%= org.plan %>" disabled style="background:#f5f5f4;color:#57534e">
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
  </form>
  <% } else { %>
  <div style="space-y:12px">
    <div style="margin-bottom:16px">
      <div class="label" style="margin-bottom:4px">Organization Name</div>
      <div style="font-size:15px;font-weight:500"><%= org.name %></div>
    </div>
    <div style="margin-bottom:16px">
      <div class="label" style="margin-bottom:4px">Plan</div>
      <div style="font-size:15px;font-weight:500;text-transform:capitalize"><%= org.plan %></div>
    </div>
    <p style="font-size:13px;color:#a8a29e;margin-top:20px">Contact your administrator to modify organization settings.</p>
  </div>
  <% } %>
</div>
<%- include('partials/footer') %>
